{
  "name": "sleepers-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D map of the history of software engineering, shipped as one offline HTML file",
  "license": "MIT",
  "scripts": {
    "merge": "node scripts/merge-data.mjs",
    "validate": "node scripts/validate-data.mjs",
    "validate:strict": "node scripts/validate-data.mjs --strict",
    "build": "node scripts/merge-data.mjs && node scripts/build.mjs",
    "build:release": "node scripts/merge-data.mjs && node scripts/build.mjs --strict",
    "test:data": "node --test \"tests/data.test.mjs\" \"tests/layout.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e.test.mjs\"",
    "test": "node scripts/merge-data.mjs && node scripts/build.mjs --strict && node --test --test-concurrency=1 \"tests/*.test.mjs\""
  },
  "dependencies": {
    "d3-force-3d": "^3.0.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0"
  }
}
